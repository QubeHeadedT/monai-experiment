# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local MLflow store (when MLFLOW_TRACKING_URI is not set)
mlflow.db
mlruns/
mlartifacts/

# Raw dataset (~2.7 GB, re-downloaded by `dvc repro download`; cache: false, so DVC doesn't ignore it)
data/raw/

# MONAI bundle downloads (pretrained weights)
data/pretrained/

# Local secrets (MLflow ARN, AWS credentials)
.env
